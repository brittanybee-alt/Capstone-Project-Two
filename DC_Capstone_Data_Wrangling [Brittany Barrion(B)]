        "        .agg(n_tracts=\"count\", median_std_error=\"median\").round(3))\n",
        "\n",
        "MIN_KIDS = 20   # minimum number of children for a reliable estimate (easy to change)\n",
        "n_small = int((clean[\"pooled_pooled_count\"] < MIN_KIDS).sum())\n",
        "clean = clean[clean[\"pooled_pooled_count\"] >= MIN_KIDS]\n",
