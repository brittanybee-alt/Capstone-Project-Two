      "source": [
        "# IQR outlier counts and skew for every remaining predictor\n",
        "def iqr_outliers(s):\n",
        "    q1, q3 = s.quantile([0.25, 0.75])\n",
        "    iqr = q3 - q1\n",
        "    return int(((s < q1 - 1.5 * iqr) | (s > q3 + 1.5 * iqr)).sum())\n",
        "\n",
        "pred_now = [c for c in predictor_cols if c in clean.columns]\n",
        "outlier_table = pd.DataFrame({\n",
        "    \"n_outliers\": clean[pred_now].apply(iqr_outliers),\n",
        "    \"skew\": clean[pred_now].skew().round(2),\n",
        "    \"max\": clean[pred_now].max().round(1),\n",
        "}).sort_values(\"n_outliers\", ascending=False)\n",
        "display(outlier_table.head(8))\n",
        "\n",
        "# Box plots of the two most skewed columns (log scale so the box is visible)\n",
        "fig, axes = plt.subplots(1, 2, figsize=(9, 4))\n",
        "for ax, col in zip(axes, [\"popdensity2010\", \"job_density_2013\"]):\n",
        "    ax.boxplot(clean[col].clip(lower=0.1), vert=True)\n",
        "    ax.set_yscale(\"log\")\n",
        "    ax.set_title(col)\n",
        "plt.tight_layout()\n",
        "plt.show()"
