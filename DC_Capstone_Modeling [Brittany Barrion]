        "# Compare all models on the cross-validation scores from the training set\n",
        "complexity = {\"Linear regression\": 1, \"Ridge regression\": 2, \"Lasso regression\": 2, \"Random forest\": 3}\n",
        "\n",
        "rows = []\n",
        "for name, s in cv_results.items():\n",
        "    n = len(s[\"r2\"])\n",
        "    rows.append({\"model\": name,\n",
        "                 \"cv_r2\": s[\"r2\"].mean(), \"cv_r2_se\": s[\"r2\"].std(ddof=1) / np.sqrt(n),\n",
        "                 \"cv_mae\": s[\"mae\"].mean(), \"cv_rmse\": s[\"rmse\"].mean(),\n",
        "                 \"complexity\": complexity.get(name, 0)})\n",
        "comparison = pd.DataFrame(rows).set_index(\"model\")\n",
        "display(comparison.round(4))\n",
        "\n",
        "# One-standard-error rule among the real models (not the baseline)\n",
        "candidates = comparison[comparison[\"complexity\"] > 0]\n",
        "best_name = candidates[\"cv_r2\"].idxmax()\n",
        "threshold = candidates.loc[best_name, \"cv_r2\"] - candidates.loc[best_name, \"cv_r2_se\"]\n",
        "eligible = candidates[candidates[\"cv_r2\"] >= threshold]\n",
        "min_complexity = eligible[\"complexity\"].min()\n",
        "final_name = eligible[eligible[\"complexity\"] == min_complexity][\"cv_r2\"].idxmax()\n",
        "\n",
        "print(f\"Best cross-validated R2: {best_name} ({candidates.loc[best_name, 'cv_r2']:.3f})\")\n",
        "print(f\"Within one standard error means R2 of at least {threshold:.3f}\")\n",
        "print(\"Models within that range:\", list(eligible.index))\n",
        "print(f\"Chosen model (simplest within the range): {final_name}\")"
      ]
