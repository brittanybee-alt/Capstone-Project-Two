      "source": [
        "# Do the predictors overlap? Variance inflation factor (VIF): above about 5 signals overlap\n",
        "def vif_table(X):\n",
        "    rows = {}\n",
        "    for col in X.columns:\n",
        "        others = X.drop(columns=col)\n",
        "        r2 = LinearRegression().fit(others, X[col]).score(others, X[col])\n",
        "        rows[col] = 1 / (1 - r2) if r2 < 1 else np.inf\n",
        "    return pd.Series(rows).sort_values(ascending=False)\n",
        "\n",
        "vif = vif_table(X_train)\n",
        "display(vif.round(1).to_frame(\"VIF\"))"
      ]
    },
