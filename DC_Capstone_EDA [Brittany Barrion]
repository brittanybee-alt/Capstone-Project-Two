        "# Evidence for each decision\n",
        "print(\"Correlation of each overlapping pair, and each column's correlation with the outcome:\")\n",
        "for a, b in [(\"jobs_total_5mi_2015\", \"jobs_highpay_5mi_2015\"),\n",
