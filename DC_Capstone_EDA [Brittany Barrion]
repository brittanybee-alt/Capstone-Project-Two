        "# Build the engineered feature table\n",
        "features = df[[\"tract_id\", \"county_fips\", \"state_label\", OUTCOME, \"jail_clipped\", \"pooled_pooled_count\"]].copy()\n",
        "\n",
        "for p in kept:\n",
        "    if p in to_log:\n",
        "        features[\"log_\" + p] = np.log1p(df[p])\n",
        "    else:\n",
        "        features[p] = df[p]\n",
        "\n",
        "# One-hot encode state (DC is the baseline)\n",
        "state_dummies = pd.get_dummies(df[\"state_label\"], prefix=\"state\", drop_first=True, dtype=int)\n",
        "features = pd.concat([features, state_dummies], axis=1)\n",
        "\n",
        "print(\"Engineered table:\", features.shape)\n",
        "print(\"State dummy columns:\", list(state_dummies.columns))\n",
        "print(\"Missing values:\", int(features.isnull().sum().sum()))\n",
