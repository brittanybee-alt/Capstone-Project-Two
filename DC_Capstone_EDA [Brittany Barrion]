      "source": [
        "# One-way ANOVA, Kruskal-Wallis, and effect size for state\n",
        "state_groups = [g[OUTCOME].values for _, g in df.groupby(\"state_label\")]\n",
        "f_stat, anova_p = stats.f_oneway(*state_groups)\n",
        "h_stat, kw_p = stats.kruskal(*state_groups)\n",
        "\n",
        "grand_mean = df[OUTCOME].mean()\n",
        "ss_between = sum(len(g) * (g.mean() - grand_mean) ** 2 for g in state_groups)\n",
        "ss_total = ((df[OUTCOME] - grand_mean) ** 2).sum()\n",
        "eta_sq_state = ss_between / ss_total\n",
        "\n",
        "print(f\"ANOVA (state):          F = {f_stat:.1f}, p = {anova_p:.2e}\")\n",
        "print(f\"Kruskal-Wallis (state): H = {h_stat:.1f}, p = {kw_p:.2e}\")\n",
        "print(f\"Eta-squared (state):    {eta_sq_state:.2f}  (share of variation explained by state)\")\n",
        "\n",
        "# Which pairs of states differ?\n",
        "labels = sorted(df[\"state_label\"].unique())\n",
        "tukey = stats.tukey_hsd(*state_groups)\n",
        "print(\"\\nTukey HSD pairwise p-values:\")\n",
        "display(pd.DataFrame(tukey.pvalue, index=labels, columns=labels).round(4))"
      ]
    },
